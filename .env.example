# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# O .env NÃO vai para o Git (está no .gitignore); o .env.example vai.

# Usados pelo compose.yaml para criar o Postgres
DB_NAME=base
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Usados pela aplicação (precisam bater com os valores acima)
DB_URL=jdbc:postgresql://localhost:5432/base

# Porta da API (opcional, padrão 8080)
PORT=8080
